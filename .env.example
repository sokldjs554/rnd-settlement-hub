# ===== Database =====
# 로컬 개발(호스트에서 직접 실행) 시 사용. docker compose는 내부 네트워크 주소를 자동 주입한다.
DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/settlement_hub

# docker compose의 postgres 초기화 값
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=settlement_hub
POSTGRES_PORT=5432
API_PORT=8000

# ===== Auth =====
# 운영에서는 반드시 무작위 값으로 교체: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== AI (Claude API) =====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ===== 외부 공공 API (공공데이터포털 https://www.data.go.kr) =====
# 국세청_사업자등록정보 진위확인 및 상태조회 서비스 활용신청 후 발급되는 serviceKey (Decoding 키)
NTS_API_KEY=
# 한국천문연구원_특일 정보 (공휴일 조회, optional — 없으면 내장 공휴일 시드만 사용)
KASI_API_KEY=

# ===== 파일 저장 =====
UPLOAD_DIR=./uploads

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
